# Environment Configuration Template for ATHLETIQ Backend
# Copy this file to .env and configure values for your environment.

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/athletiq?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/athletiq

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Authentication JWT Secrets & Expirations
# Secrets MUST be at least 32 characters long and MUST differ from each other.
# Generate high-entropy 48-byte hex secrets using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_GRACE_MS=30000

# Global Rate Limiting (applies to /api)
# Window in milliseconds (defaults to 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (defaults: 5000 in development, 600 in production)
RATE_LIMIT_MAX=5000

# Document Upload Storage (stored outside public static folder)
DOCUMENT_UPLOAD_DIR=./uploads/documents
MAX_DOCUMENT_SIZE_BYTES=5242880

# Contact Message Rate Limiting (applies to POST /api/public/contact)
RATE_LIMIT_CONTACT_WINDOW_MS=3600000
RATE_LIMIT_CONTACT_MAX=5

# Password Reset Rate Limiting (applies to POST /api/auth/forgot-password)
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5

# Reverse Proxy / Hosted Deployment (hops count: default 1 in production, 0 in development)
# Set to 1 behind Render, Heroku, AWS ALB, Vercel, or Cloudflare
TRUST_PROXY=1

# Cross-Origin Resource Sharing (CORS) - Comma-separated exact origins (never "*")
# Defaults to http://localhost:5173 plus FRONTEND_URL / CLIENT_URL
CORS_ORIGINS=http://localhost:5173,https://athletiq-frontend.vercel.app
FRONTEND_URL=https://athletiq-frontend.vercel.app

# Refresh Token Cookie Configuration
# COOKIE_SAMESITE: 'lax' (same-origin / proxy rewrite) | 'none' (cross-site) | 'strict'
# Note: COOKIE_SAMESITE=none REQUIRES COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_SECURE: true | false (default: true in production, false in development)
COOKIE_SECURE=false
# COOKIE_DOMAIN: Optional domain attribute (leave empty for default host)
COOKIE_DOMAIN=

# Chatbot Rate Limiting (applies to /api/chatbot)
# Window in milliseconds (defaults to 600000 = 10 minutes)
CHATBOT_RATE_LIMIT_WINDOW_MS=600000
# Max messages per window per user (defaults to 20)
CHATBOT_RATE_LIMIT_MAX=20

# Transactional SMTP Mailer (Optional in dev/test - logs to console fallback if omitted)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.mailgun.org
SMTP_PASS=your_smtp_password
SMTP_FROM="ATHLETIQ Academy <no-reply@athletiq.app>"
