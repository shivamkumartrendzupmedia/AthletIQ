# Environment Configuration Template for ATHLETIQ Backend
# Copy this file to .env and configure values for your environment.

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/athletiq?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/athletiq

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Authentication JWT Secrets & Expirations
# Secrets MUST be at least 32 characters long and MUST differ from each other.
# Generate high-entropy 48-byte hex secrets using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Global Rate Limiting (applies to /api)
# Window in milliseconds (defaults to 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (defaults: 5000 in development, 600 in production)
RATE_LIMIT_MAX=5000

# Document Upload Storage (stored outside public static folder)
DOCUMENT_UPLOAD_DIR=./uploads/documents
MAX_DOCUMENT_SIZE_BYTES=5242880
